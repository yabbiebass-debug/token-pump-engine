# --- Token Pump Engine · hot-wallet executor config ---
# Copy to backend/.env and fill secrets. NEVER commit the filled file.
MONGO_URL=mongodb://localhost:27017
DB_NAME=token_pump_engine
CORS_ORIGINS=*
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Hot-wallet auto-buy executor (server signs Jupiter swaps itself).
# OFF by default. Turn on only on a hardened host.
EXECUTOR_ENABLED=false
# 64-int JSON array OR base58 secret key. Must derive EXECUTOR_PUBKEY.
EXECUTOR_SECRET_KEY=
# Must equal the flywheel signer_wallet in config (default HTN1fv…ZV5i).
EXECUTOR_PUBKEY=HTN1fvHwbzKiMwh9YXZEe3eooiMdoCAs3TweWdiSZV5i

# Distributed nodes: shared bearer key that workers present to register.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
NODE_API_KEY=change-me-to-64-hex-chars

# Optional alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMERGENT_LLM_KEY=
